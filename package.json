{
  "name": "health-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-bct",
    "test": "firebase emulators:exec --only auth,firestore --project demo-bct \"node --test --test-concurrency=1 tests/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bct \"node --test tests/firestore.rules.test.mjs\"",
    "admin:grant": "node scripts/set-admin.mjs grant",
    "admin:revoke": "node scripts/set-admin.mjs revoke",
    "deploy": "npm run build && firebase deploy",
    "deploy-rules": "firebase deploy --only firestore:rules",
    "deploy-hosting": "firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "primeicons": "^6.0.1",
    "primevue": "^3.29.0",
    "vue": "^3.5.44",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.34.0",
    "vite": "^7.3.7",
    "vite-plugin-vue-devtools": "^7.7.7"
  }
}
