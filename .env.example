# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY="your-firebase-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Development Configuration
NODE_ENV="development"

# Use local Firebase emulators instead of the real project (npm run emulators)
VITE_USE_EMULATORS="false"

# Admin roles are NOT configured here. Anything prefixed VITE_ is shipped to the browser.
# Grant the first admin with: npm run admin:grant -- <email>   (see README > Admin Setup)
